#!/bin/sh

# install packages (copy mirrorlist before)
sudo cp etc/pacman.d/mirrorlist /etc/pacman.d/
sudo pacman -Syu --noconfirm
sudo pacman -S --noconfirm base-devel bash-completion i3lock bspwm btop curl exfatprogs fastfetch feh flameshot git htop kitty lightdm gnome-themes-extra mpc mpd mpd-mpris mpv ncmpcpp ttf-nerd-fonts-symbols ttf-nerd-fonts-symbols-mono noto-fonts-cjk noto-fonts-emoji noto-fonts nvme-cli pavucontrol pulseaudio pcmanfm picom polybar qemu ranger refind rofi sl smartmontools sxhkd testdisk tldr tmux vim w3m xorg-xinit xorg xorg-server bc imagemagick wget zip unzip ttf-jetbrains-mono cpupower vulkan-intel gimp plymouth chrony pacman-contrib terminus-font cdrtools virtualbox cantarell-fonts sbctl openssh vi lightdm-webkit2-greeter acpi stress dunst libnotify brightnessctl pamixer ttf-jetbrains-mono-nerd obs-studio sof-firmware libfdk-aac openresolv wireguard-tools xorg-xcalc fuse ntsync-autoload alsa-utils

# copy files

cp -r files/spike/* /home/spike/

sudo cp -r files/etc/* /etc/
sudo cp -r files/usr/* /usr/
sudo cp -r files/efi/* /efi/

# font

sudo systemctl restart systemd-vconsole-setup.service 

# install non-packaged things

cd files/git/
make -C ble.sh install PREFIX=/home/spike/.local
cd ../../

files/installstarship.sh -f

cd files/git/i3lock-color
sh install-i3lock-color.sh
cd ../../..

wget https://raw.githubusercontent.com/betterlockscreen/betterlockscreen/main/install.sh -O - -q | sudo bash -s system
curl -s https://updates.zen-browser.app/install.sh | sh
sudo chmod +x /usr/bin/zen

# install the cachyos kernel

sudo pacman-key --recv-keys F3B607488DB35A47 --keyserver keyserver.ubuntu.com
sudo pacman-key --lsign-key F3B607488DB35A47
sudo pacman -U \
https://mirror.cachyos.org/repo/x86_64/cachyos/cachyos-keyring-20240331-1-any.pkg.tar.zst \
https://mirror.cachyos.org/repo/x86_64/cachyos/cachyos-mirrorlist-27-1-any.pkg.tar.zst
sudo pacman -Syu --noconfirm
sudo pacman -S --noconfirm linux-cachyos linux-cachyos-headers

# finish

sudo systemctl enable --now chronyd
sudo systemctl enable --now cpupower.service
gsettings set org.gnome.desktop.interface color-scheme prefer-dark
sudo timedatectl set-timezone Europe/Warsaw
sudo plymouth-set-default-theme macOS -R
sudo hwclock --systohc
sudo sysctl --system
sudo locale-gen
sudo chmod -R u+rw /etc/wireguard/
sudo chown -R spike:spike /etc/wireguard/

# done

sudo systemctl enable --now dbus
sudo systemctl enable --now lightdm
soft-reboot
