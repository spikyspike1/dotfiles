
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
	  "os",
    {
	    "key": "OS age",
	    "type": "command",
	    "keyColor": "#FF66CC",
    	    "text": "echo \"$(( ($(date +%s) - $(stat -c %W /)) / 3600 )) hours ($(stat -c %w / | cut -d' ' -f1))\""

    },
    "uptime",
    "terminal",
    "wm",

  ],
  "display": {"separator": " 󰁔  ",
    "color": {
      "keys": "#FF66CC",
      "title": "#FF66CC",
      "output": "#FFFFFF",
      "separator": "#FFFFFF"
    }
  },
  "logo": {
	  "type": "small",
    "color": {
      "1": "#FF66CC",
      "2": "#FF66CC",
      "3": "#FF66CC"
    },
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2,
      "bottom": 0
    }
  }
}
