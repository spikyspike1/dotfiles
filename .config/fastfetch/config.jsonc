
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    {
	    "key": "OS age",
	    "type": "command",
	    "keyColor": "#FF66CC",
    	    "text": "echo \"$(( ($(date +%s) - $(stat -c %W /)) / 3600 )) hours ($(stat -c %w / | cut -d' ' -f1))\""

    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "disk",
    "break",
    "colors"
  ],
  "display": {"separator": " 󰁔  ",
    "color": {
      "keys": "#FF66CC",
      "title": "#FF66CC",
      "output": "#FFFFFF",
      "separator": "#FFFFFF"
    }
  },
  "logo": {
	  "type": "file",
	  "source": "/home/spike/.config/fastfetch/arch.txt",
//	  "padding": {
//		  "top": 1},
    "color": {
      "1": "#FF66CC",
      "2": "#FF66CC",
      "3": "#FF66CC"
    }
  }
}
