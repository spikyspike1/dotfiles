#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor -d 1 2 3 4 5

export XCURSOR_THEME=Bibata-Modern-Classic
export XCURSOR_SIZE=24
xrdb -merge /home/spike/.Xresources 
xsetroot -cursor_name left_ptr
xset r rate 200 48
dunst &
bspc config border_width         0
bspc config window_gap          12
bspc config focus_follows_pointer true
#bspc config single_monocle 	 true
#bspc config gapless_monocle 	 true

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc config normal_border_color '#FF66CC'
bspc config focused_border_color '#FF66CC'
bspc config active_border_color '#FF66CC'

bspc rule -a Dunst layer=above

sleep 10
~/.config/bspwm/scripts/updates.sh &
~/.config/bspwm/scripts/battery.sh &
